{
  "name": "taska-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "format": "prettier --write src tests *.json *.js *.html docs README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.6.2",
    "vite": "^7.3.7"
  }
}
